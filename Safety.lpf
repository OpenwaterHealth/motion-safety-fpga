# Keep the configuration bitstream out of the UFM sector.  CFG is the Diamond
# default, but it is stated here because the calibration record in the UFM would
# be overwritten if the bitstream were ever allowed to overflow into it.
SYSCONFIG CONFIGURATION=CFG ;
